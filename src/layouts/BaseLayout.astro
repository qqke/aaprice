---
import '@/styles/global.css';

const {
  title = 'AAPRICE | 日本药妆商品比价',
  description = '比较日本药妆商品、门店价格与单位价格。',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site || new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, site);
const socialImageUrl = new URL(`${base}/favicon.ico`, site);
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4faf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#122421" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : prefersDark);
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="fixed left-3 top-3 z-50 inline-flex min-h-11 -translate-y-20 items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-transform focus:translate-y-0">跳至主要内容</a>
    <slot />
    <footer class="border-t bg-background">
      <div class="mx-auto flex max-w-[1320px] flex-col gap-3 px-4 py-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p>© 2026 AAPRICE · 价格仅供参考，请以商家结算页面为准。</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="站点说明">
          <a href={`${base}/privacy/`} class="min-h-11 content-center transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">隐私与数据</a>
          <a href={`${base}/disclosure/`} class="min-h-11 content-center transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">联盟与服务说明</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
