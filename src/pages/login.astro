---
import AuthApp from '@/components/AuthApp.jsx';
import '@/styles/global.css';
---
<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="登录、注册或找回 AAPRICE 账号。" />
    <title>AAPRICE | 账户</title>
    <script is:inline>const t=localStorage.getItem('theme');document.documentElement.classList.toggle('dark',t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches);</script>
  </head>
  <body><AuthApp client:load /></body>
</html>
