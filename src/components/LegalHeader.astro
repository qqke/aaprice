    <a href={appPath('/')} class="flex min-h-11 items-center gap-3" aria-label="AAPRICE 首页"><span class="grid size-9 place-items-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground">AA</span><span class="font-semibold tracking-[-0.04em]">AAPRICE</span></a>
