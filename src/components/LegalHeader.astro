---
import { appPath } from '@/lib/paths.mjs';
---

<header class="site-header border-b bg-card/95 backdrop-blur-xl">
  <div class="mx-auto flex h-[72px] max-w-[1200px] items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={appPath('/')} class="flex min-h-11 items-center gap-2" aria-label="LOWPRICE 首页"><img src="/lowprice-logo.png" alt="LOWPRICE" class="h-10 w-auto object-contain" /><span class="hidden text-base font-bold tracking-tight min-[375px]:inline">LOWPRICE</span></a>
    <a href={appPath('/#catalog')} class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">返回商品比较</a>
  </div>
</header>
