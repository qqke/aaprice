---
import BaseLayout from '@/layouts/BaseLayout.astro';
const home = import.meta.env.BASE_URL;
---

<BaseLayout title="AAPRICE | 页面不存在" description="找不到请求的页面。" noindex>
  <main id="main-content" tabindex="-1" class="grid min-h-[100dvh] place-items-center px-4 py-16">
    <div class="w-full max-w-xl border-y py-12">
      <a href={home} class="flex items-center gap-3" aria-label="AAPRICE 首页">
        <span class="grid size-10 place-items-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground">AA</span>
        <span class="font-semibold tracking-[-0.04em]">AAPRICE</span>
      </a>
      <p class="mt-12 font-mono text-sm text-primary">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.045em]">这里没有商品。</h1>
      <p class="mt-4 text-muted-foreground">页面可能已移动，返回首页重新搜索或扫码。</p>
      <a href={home} class="mt-8 inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-transform active:translate-y-px">返回首页</a>
    </div>
  </main>
</BaseLayout>
