---
import AdminApp from '@/components/AdminApp.jsx';
import '@/styles/global.css';
---
<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AAPRICE 管理后台。" />
    <title>AAPRICE | 管理后台</title>
    <script is:inline>const t=localStorage.getItem('theme');document.documentElement.classList.toggle('dark',t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches);</script>
  </head>
  <body><AdminApp client:load /></body>
</html>
